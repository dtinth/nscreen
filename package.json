{
  "name": "nscreen",
  "version": "0.2.0",
  "description": "Push HTML/CSS/JS to a remote screen through Nostr relays, end-to-end encrypted",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/publisher.d.mts",
      "default": "./lib/publisher.mjs"
    },
    "./display.html": "./dist/index.html"
  },
  "files": [
    "lib",
    "dist/index.html"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs && tsdown",
    "typecheck": "tsc -p .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "nostr",
    "signage",
    "display",
    "screen",
    "e2ee"
  ],
  "author": "dtinth",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtinth/nscreen.git"
  },
  "homepage": "https://nscreen.pages.dev/",
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "fflate": "^0.8.3",
    "nostr-tools": "^2.26.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "idiomorph": "^0.8.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "rolldown": "1.3.2"
  }
}
